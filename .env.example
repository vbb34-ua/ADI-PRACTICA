# Configuración de Supabase para Gestor de Torneos
# Sustituye estos valores con los de tu proyecto en Supabase (Settings -> API)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-public-key-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-opcional-para-tests-admin

# Puerto opcional si se requiere
PORT=3000
